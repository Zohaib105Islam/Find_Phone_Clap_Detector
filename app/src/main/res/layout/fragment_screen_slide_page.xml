<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backColor"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/_8sdp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_18sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/text_card_light_bg"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/text_card_bg"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/onboarding_clap_new" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_24sdp"
        android:fontFamily="@font/inter_bold"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/colorTextDark"
        android:textSize="26sp"
        tools:text="Clap to Find It" />

    <TextView
        android:id="@+id/description_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_26sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:maxLines="3"
        android:textColor="@color/gray_text"
        android:textSize="15sp"
        tools:text="Clap once to trigger your chosen alert and locate your phone in seconds." />

</LinearLayout>
