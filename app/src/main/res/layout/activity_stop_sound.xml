<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg"
    android:layoutDirection="locale"
    tools:context=".ui.activities.StopSoundActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/stopSoundScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="52dp">

                <FrameLayout
                    android:id="@+id/headerIconContainer"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_stop_sound_header_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/stop_sound_ic_sound_wave" />

                </FrameLayout>

                <TextView
                    android:id="@+id/screenTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/stop_sound_screen_title"
                    android:textColor="@color/settings_text_primary"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toTopOf="@id/screenSubtitle"
                    app:layout_constraintEnd_toStartOf="@id/liveStatus"
                    app:layout_constraintStart_toEndOf="@id/headerIconContainer"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/screenSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/stop_sound_screen_subtitle"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/liveStatus"
                    app:layout_constraintStart_toEndOf="@id/headerIconContainer"
                    app:layout_constraintTop_toBottomOf="@id/screenTitle" />

                <TextView
                    android:id="@+id/liveStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_stop_sound_live_badge"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/stop_sound_live"
                    android:textColor="@color/settings_blue_deep"
                    android:textSize="10sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="252dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_stop_sound_hero"
                android:elevation="6dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/alertStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_stop_sound_status_chip"
                    android:fontFamily="@font/inter_semi_bold"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="@string/stop_sound_alert_active"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <FrameLayout
                    android:id="@+id/alertVisual"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_stop_sound_alert_ring_outer"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/alertStatus">

                    <FrameLayout
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_stop_sound_alert_ring_inner">

                        <FrameLayout
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_stop_sound_alert_icon">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/stop_sound_bell_content_description"
                                android:src="@drawable/stop_sound_ic_ringing_bell" />

                        </FrameLayout>

                    </FrameLayout>

                </FrameLayout>

                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_extra_bold"
                    android:text="@string/stop_sound_hero_title"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/alertVisual" />

                <TextView
                    android:id="@+id/heroSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/stop_sound_hero_subtitle"
                    android:textColor="#DCEBFF"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/heroTitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/settings_surface"
                app:cardCornerRadius="26dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/settings_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:letterSpacing="0.1"
                        android:text="@string/stop_sound_quick_action"
                        android:textColor="@color/settings_blue"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_bold"
                        android:text="@string/stop_sound_silence_title"
                        android:textColor="@color/settings_text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/inter_regular"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/stop_sound_silence_hint"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="12sp" />

                    <com.ncorti.slidetoact.SlideToActView
                        android:id="@+id/sliderBtn"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="14dp"
                        app:animate_completion="true"
                        app:animation_duration="250"
                        app:area_margin="5dp"
                        app:border_radius="18dp"
                        app:bounce_duration="350"
                        app:bounce_on_start="true"
                        app:bounce_repeat="1"
                        app:complete_icon="@drawable/stop_sound_ic_check"
                        app:inner_color="@color/settings_blue"
                        app:outer_color="@color/settings_surface_soft"
                        app:slider_height="50dp"
                        app:slider_icon="@drawable/stop_sound_ic_slide_arrow"
                        app:slider_icon_color="@color/white"
                        app:slider_locked="false"
                        app:text="@string/stop_sound_slide_to_silence"
                        app:text_color="@color/settings_text_primary"
                        app:text_size="12sp"
                        app:text_style="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_stop_sound_keep_active"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp">

                        <View
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/bg_stop_sound_active_dot" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/stop_sound_detection_stays_active"
                            android:textColor="@color/settings_blue_deep"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/settings_divider" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:fontFamily="@font/inter_semi_bold"
                            android:text="@string/stop_sound_or"
                            android:textColor="@color/settings_text_secondary"
                            android:textSize="10sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/settings_divider" />

                    </LinearLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/stop_service_btn"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_stop_sound_deactivate"
                        android:clickable="true"
                        android:contentDescription="@string/stop_sound_deactivate_content_description"
                        android:focusable="true"
                        android:paddingStart="12dp"
                        android:paddingEnd="14dp">

                        <FrameLayout
                            android:id="@+id/deactivateIconContainer"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_stop_sound_deactivate_icon"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="23dp"
                                android:layout_height="23dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/stop_sound_ic_power" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/deactivateTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/inter_semi_bold"
                            android:text="@string/stop_sound_deactivate_title"
                            android:textColor="@color/settings_text_primary"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toTopOf="@id/deactivateSubtitle"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/deactivateIconContainer"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed" />

                        <TextView
                            android:id="@+id/deactivateSubtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="@string/stop_sound_deactivate_hint"
                            android:textColor="@color/settings_text_secondary"
                            android:textSize="10sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/deactivateIconContainer"
                            app:layout_constraintTop_toBottomOf="@id/deactivateTitle" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
