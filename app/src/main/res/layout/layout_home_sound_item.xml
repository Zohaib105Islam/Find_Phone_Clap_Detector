<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_82sdp"
    android:layout_height="@dimen/_92sdp"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:paddingHorizontal="@dimen/_3sdp"
    android:paddingVertical="@dimen/_3sdp">

    <FrameLayout
        android:id="@+id/circleContainer"
        android:layout_width="@dimen/_62sdp"
        android:layout_height="@dimen/_62sdp"
        android:background="@drawable/home_sound_circle_unselected"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/soundImage"
            android:layout_width="@dimen/_43sdp"
            android:layout_height="@dimen/_43sdp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            tools:src="@drawable/ic_cat_meo" />

    </FrameLayout>

    <ImageView
        android:id="@+id/ivSelectedDot"
        android:layout_width="@dimen/_18sdp"
        android:layout_height="@dimen/_18sdp"
        android:background="@drawable/home_sound_check_badge"
        android:padding="@dimen/_3sdp"
        android:src="@drawable/baseline_check_24"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/circleContainer"
        app:layout_constraintTop_toTopOf="@+id/circleContainer"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/soundTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/colorTextDark"
        android:textSize="@dimen/_9sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/circleContainer"
        tools:text="Cat meowing" />

</androidx.constraintlayout.widget.ConstraintLayout>
