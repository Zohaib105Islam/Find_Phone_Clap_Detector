<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backColor"
    tools:context=".ui.activities.PermissionsActivity">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animation_view_ripple_on"
        android:layout_width="@dimen/_200sdp"
        android:layout_height="@dimen/_200sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/ripple" />

    <com.airbnb.lottie.LottieAnimationView
        android:layout_width="@dimen/_170sdp"
        android:layout_height="@dimen/_170sdp"
        app:layout_constraintBottom_toBottomOf="@+id/animation_view_ripple_on"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        android:padding="@dimen/_10sdp"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/permission_animation" />

    <LinearLayout
        android:id="@+id/permissionContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_5sdp"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/permissionBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/animation_view_ripple_on">

        <!-- For Android 13+ -->
        <LinearLayout
            android:id="@+id/post13Container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <include
                android:id="@+id/item_audio_post13"
                layout="@layout/item_permission_status" />

            <include
                android:id="@+id/item_notification"
                layout="@layout/item_permission_status" />

            <include
                android:id="@+id/item_media_audio"
                layout="@layout/item_permission_status" />
        </LinearLayout>

        <!-- For Android <= 12 -->
        <LinearLayout
            android:id="@+id/pre13Container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <include
                android:id="@+id/item_audio_pre13"
                layout="@layout/item_permission_status" />

            <include
                android:id="@+id/item_read_storage"
                layout="@layout/item_permission_status" />

            <include
                android:id="@+id/item_write_storage"
                layout="@layout/item_permission_status" />
        </LinearLayout>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/permissionBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="@dimen/_30sdp"
        android:background="@drawable/orange_bg"
        android:backgroundTint="@color/primary"
        android:paddingStart="60dp"
        android:paddingTop="6dp"
        android:paddingEnd="60dp"
        android:paddingBottom="6dp"
        android:text="@string/allow_permissions"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout_editor_absoluteX="26dp" />
</androidx.constraintlayout.widget.ConstraintLayout>