<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg"
    tools:context=".ui.activities.SaveRecordingActivity">

    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:paddingStart="16dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_save_recording_back"
            android:contentDescription="@string/save_recording_back_content_description"
            android:padding="12dp"
            android:src="@drawable/save_recording_ic_back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/backIcon"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/save_recording_toolbar_title"
                android:textColor="@color/settings_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/save_recording_toolbar_subtitle"
                android:textColor="@color/settings_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_save_recording_step_badge"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/save_recording_final_step"
            android:textColor="@color/settings_blue"
            android:textSize="10sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="@drawable/bg_save_recording_hero"
                android:clipToOutline="true"
                android:elevation="6dp"
                android:padding="20dp">

                <View
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_save_recording_glow"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/saveReadyBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_save_recording_complete_badge"
                    android:drawableStart="@drawable/save_recording_ic_check_small"
                    android:drawablePadding="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:text="@string/save_recording_complete_badge"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <FrameLayout
                    android:id="@+id/saveArtwork"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_save_recording_artwork_outer"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/saveReadyBadge">

                    <FrameLayout
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_save_recording_artwork_inner">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/save_recording_ic_wave" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/saveReadyTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/save_recording_ready_title"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/saveReadyHint"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/saveArtwork"
                    app:layout_constraintTop_toTopOf="@id/saveArtwork"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/saveReadyHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/save_recording_ready_hint"
                    android:textColor="#DDEBFF"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="@id/saveArtwork"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/saveArtwork"
                    app:layout_constraintTop_toBottomOf="@id/saveReadyTitle" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="154dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeColor="#DCE9FC"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/nameStep"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_save_recording_number"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/nameLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/save_recording_name_title"
                        android:textColor="@color/settings_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/nameStep"
                        app:layout_constraintTop_toTopOf="@id/nameStep" />

                    <TextView
                        android:id="@+id/nameHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/save_recording_name_hint"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="11sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/nameStep"
                        app:layout_constraintTop_toBottomOf="@id/nameLabel" />

                    <LinearLayout
                        android:id="@+id/linearLayout3"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_save_recording_name_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/nameStep">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:contentDescription="@null"
                            android:src="@drawable/save_recording_ic_edit" />

                        <EditText
                            android:id="@+id/nameText"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:autofillHints="name"
                            android:background="@android:color/transparent"
                            android:fontFamily="sans-serif-medium"
                            android:hint="@string/save_recording_name_placeholder"
                            android:inputType="textCapSentences"
                            android:maxLength="25"
                            android:maxLines="1"
                            android:padding="0dp"
                            android:singleLine="true"
                            android:textColor="@color/settings_text_primary"
                            android:textColorHint="#7890B1"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_save_recording_edit_chip"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:text="@string/save_recording_edit_label"
                            android:textColor="@color/settings_blue"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="162dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeColor="#DCE9FC"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/previewStep"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_save_recording_number"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/previewLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/save_recording_preview_title"
                        android:textColor="@color/settings_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/previewStatus"
                        app:layout_constraintStart_toEndOf="@id/previewStep"
                        app:layout_constraintTop_toTopOf="@id/previewStep" />

                    <TextView
                        android:id="@+id/previewHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/save_recording_preview_hint"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="11sp"
                        app:layout_constraintEnd_toStartOf="@id/previewStatus"
                        app:layout_constraintStart_toEndOf="@id/previewStep"
                        app:layout_constraintTop_toBottomOf="@id/previewLabel" />

                    <TextView
                        android:id="@+id/previewStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_save_recording_preview_badge"
                        android:drawableStart="@drawable/save_recording_ic_audio_small"
                        android:drawablePadding="5dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:text="@string/save_recording_preview_badge"
                        android:textColor="@color/settings_blue"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <FrameLayout
                        android:id="@+id/playerButtonContainer"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_save_recording_player_button"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/previewStep">

                        <ImageView
                            android:id="@+id/playBtn"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/save_recording_play_content_description"
                            android:padding="18dp"
                            android:src="@drawable/save_recording_ic_play"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/pauseBtn"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/save_recording_pause_content_description"
                            android:padding="18dp"
                            android:src="@drawable/save_recording_ic_pause" />

                        <ImageView
                            android:id="@+id/stopBtn"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/save_recording_stop_content_description"
                            android:padding="18dp"
                            android:src="@drawable/save_recording_ic_stop"
                            android:visibility="gone" />
                    </FrameLayout>

                    <SeekBar
                        android:id="@+id/seekBar"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="10dp"
                        android:maxHeight="4dp"
                        android:minHeight="4dp"
                        android:progressBackgroundTint="#DCE9FC"
                        android:progressTint="@color/settings_blue"
                        android:splitTrack="false"
                        android:thumb="@drawable/bg_save_recording_seek_thumb"
                        app:layout_constraintBottom_toBottomOf="@id/playerButtonContainer"
                        app:layout_constraintEnd_toStartOf="@id/playerDuration"
                        app:layout_constraintStart_toEndOf="@id/playerButtonContainer"
                        app:layout_constraintTop_toTopOf="@id/playerButtonContainer" />

                    <TextView
                        android:id="@+id/playerDuration"
                        android:layout_width="58dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_save_recording_duration"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="@string/_00_00"
                        android:textColor="@color/settings_blue_deep"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/playerButtonContainer"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/playerButtonContainer" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/save_apply_btn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_save_recording_primary_button"
                android:clickable="true"
                android:contentDescription="@string/save_recording_save_apply_content_description"
                android:drawableStart="@drawable/save_recording_ic_apply"
                android:drawablePadding="10dp"
                android:elevation="4dp"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/save_recording_save_apply"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/save_sound_btn"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_save_recording_secondary_button"
                android:clickable="true"
                android:contentDescription="@string/save_recording_save_content_description"
                android:drawableStart="@drawable/save_recording_ic_save"
                android:drawablePadding="10dp"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/save_recording_save_library"
                android:textColor="@color/settings_blue_deep"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_save_recording_tip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="11dp"
                android:paddingEnd="14dp"
                android:paddingBottom="11dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/save_recording_ic_info" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/save_recording_tip"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
