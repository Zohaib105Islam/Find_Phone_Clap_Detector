<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:endColor="#F9FBFC"
                android:startColor="#D9E0E5" />
            <stroke
                android:width="2dp"
                android:color="#9EADB7" />
        </shape>
    </item>

    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:endColor="#E9EEF1"
                android:startColor="#FFFFFF" />
        </shape>
    </item>

</layer-list>
