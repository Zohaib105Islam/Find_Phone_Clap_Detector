<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="#E8EDF5" />
        </shape>
    </item>

    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:endColor="#C7D2E2"
                android:startColor="#7890AF" />
        </shape>
    </item>

    <item
        android:bottom="9dp"
        android:left="9dp"
        android:right="9dp"
        android:top="9dp">
        <shape android:shape="oval">
            <solid android:color="@color/white" />
        </shape>
    </item>

    <item
        android:bottom="15dp"
        android:left="15dp"
        android:right="15dp"
        android:top="15dp">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:endColor="#FFFFFF"
                android:startColor="#EEF2F7" />
            <stroke
                android:width="2dp"
                android:color="#CBD5E1" />
        </shape>
    </item>

    <item
        android:bottom="21dp"
        android:left="21dp"
        android:right="21dp"
        android:top="21dp">
        <shape android:shape="oval">
            <solid android:color="#FAFBFD" />
        </shape>
    </item>

</layer-list>
