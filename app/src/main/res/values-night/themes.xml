<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FindMyPhoneViaClap" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/colorTextGreen</item>
        <item name="android:navigationBarColor">@color/backColor</item>
        <item name="android:statusBarColor" >@color/backColor</item>
        <item name="android:windowIsTranslucent">false</item>

    </style>

    <style name="Theme.FindMyPhoneViaClap" parent="Base.Theme.FindMyPhoneViaClap" />

    <style name="RatingBar" parent="Theme.AppCompat">
        <item name="colorControlNormal">@color/iconColor</item>
        <item name="colorControlActivated">@color/yellow</item>
    </style>

    <style name="Base.Theme.FindMyPhoneViaClap.AdTheme" >
        <item name="android:background">@color/backColor</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowExitAnimation">@null</item>
        <item name="android:windowEnterAnimation">@null</item>
    </style>
</resources>
